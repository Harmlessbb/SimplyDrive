<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.LoginPage"
             Title= ""
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             x:DataType="ViewModel:LogonViewModel"
             BackgroundColor="#211D4A">


    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" Padding="5">
        
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Fill" VerticalOptions="Center" Grid.RowSpan="1" Grid.ColumnSpan="1" Color="White"></ActivityIndicator>

    </Grid>

</ContentPage>