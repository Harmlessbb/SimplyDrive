<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.LoginPage"
             Title= ""
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             x:DataType="ViewModel:LogonViewModel"
             BackgroundColor="#211D4A">

    <Grid ColumnDefinitions="*,auto,*" RowDefinitions="*,90,*" Padding="5">

        <Border Grid.Column="1" Grid.Row="1" Stroke="Black" StrokeShape="RoundRectangle 5,5,5,5">

            <Grid ColumnDefinitions="*,380,*" RowDefinitions="auto,auto,auto" Grid.Column="1" Grid.Row="1">

                <Label Text="{Binding Code}" Grid.Column="1" Grid.Row="1"></Label>

            </Grid>

        </Border>
        <Grid ColumnDefinitions="auto,200,auto" RowDefinitions="50,*,500" Grid.Row="2" Grid.Column="1" Padding="10" ColumnSpacing="10">
            <Button Text="Login" HeightRequest="10" Grid.Row="2" Grid.Column="1" WidthRequest="100" Command="{Binding AttemptLoginCommand}"></Button>
            <Button Text="AdminLogin" HeightRequest="10" Grid.Row="0" Grid.Column="1" WidthRequest="150" Command="{Binding ByPassLoginCommand}"></Button>
        </Grid>

        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Fill" VerticalOptions="Center" Grid.RowSpan="2" Grid.ColumnSpan="2" Color="White"></ActivityIndicator>
        
    </Grid>
    
    
</ContentPage>