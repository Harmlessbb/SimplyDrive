            <CollectionView IsVisible="{Binding ThereAreBookings}" BackgroundColor = "#E1E0EB" Grid.Row="2" Grid.Column="1"  Grid.RowSpan="2"
                ItemsSource="{Binding VehicleModel}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:VehicleModel">

                        <CollectionView BackgroundColor = "#E1E0EB" Grid.Row="2" Grid.Column="1"  Grid.RowSpan="2"
