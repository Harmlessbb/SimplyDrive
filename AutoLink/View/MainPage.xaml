                                            </Label>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
-->
            <Label Text="You have no scheduled appointments. Please make a booking below." IsVisible = "{Binding NoBookings}"
                TextColor="#696969"
                FontAttributes="Bold"    
                FontSize="24"
                Grid.Row="2"
                Grid.Column="1"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"
                FontFamily="RAJDHANI-REGULAR.TTF"
                    />


 

                <!--
                
                <Grid BindableLayout.ItemsSource="{Binding VehicleModel}" 
                        Grid.Row="0"    
                        Grid.Column="2">
                    
                    <BindableLayout.ItemTemplate>
                        
                        <DataTemplate x:DataType="model:VehicleModel">
                            <Label Text= "{Binding registration}"
                            TextColor="#000000"
                            BackgroundColor="#FFFF00"   
                            MaxLines="1"
                            FontAttributes="Bold"    
                            FontSize="24"
                            FontFamily="RAJDHANI-REGULAR.TTF"       />


                        </DataTemplate>
                        
                    </BindableLayout.ItemTemplate>
    
                </Grid>
                         -->   
      
            <!--
                
                <CollectionView IsVisible="{Binding ThereAreBookings}" BackgroundColor = "#E1E0EB" 
                            ItemsSource="{Binding ActiveBookings}"
                            SelectionMode="Single"
                            VerticalScrollBarVisibility="Never"
                            HeightRequest="100">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:ActiveBookings">
                            <Grid>

                                <Label  Text= "{Binding vehicleId}"
                                            TextColor="#000000"
                                            BackgroundColor="#FFFF00"   
                                            MaxLines="1"
                                            FontAttributes="Bold"    
                                            FontSize="72"
                                            FontFamily="RAJDHANI-REGULAR.TTF"
                                            />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
                -->

            </Grid>

            

            <Grid ColumnDefinitions="*,2.6*,*" RowDefinitions="*,2.6*,*" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="100" Grid.RowSpan="100">

                <BoxView 
                    Color="#E1E0EB" 
                    Grid.Row="0"
                    Grid.RowSpan="100"
                    Grid.Column="0"
                    Grid.ColumnSpan ="3"
                    BackgroundColor = "#E1E0EB"
                    CornerRadius= "8"
                    />


                <BoxView 
                    Color="#211D4A" 
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.RowSpan="1"
                    
                    BackgroundColor = "#E1E0EB"
                    CornerRadius= "8"
                    />

                <Label x:Name="label" Text="New Booking"

                    TextColor="#FFFFFF"
                    FontAttributes="Bold"    
                    FontSize="30"
                    Grid.Row="1"
                    Grid.Column="1"   
                    FontFamily="RAJDHANI-REGULAR.TTF"
                    VerticalOptions="Center"

                    HorizontalOptions="Center"   />


          
            </Grid>



        </Grid>


    </Grid>
</ContentPage>
