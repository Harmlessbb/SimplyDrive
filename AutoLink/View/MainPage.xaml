<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.MainPage"
             xmlns:model="clr-namespace:AutoLink.Model"
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             x:DataType="ViewModel:MainPageViewModel"
             Title=""  BackgroundColor="#FFFFFF">
    
    <Page.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="#211D4A"/>
    </Page.Behaviors>

    <Grid ColumnDefinitions="*" RowDefinitions="0.6*,11*,1*">

        <Grid ColumnDefinitions="*,40,10" RowDefinitions="*,0,0" Grid.Row="0" Grid.Column="0" >

            <BoxView 
                Color="#211D4A" 
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                BackgroundColor="#211D4A"
                Shadow="#000000 0 0.1"/>

            <Label Text="{Binding UserName, StringFormat='{}Hello, {0}!'}"
                TextColor="#FFFFFF"
                FontAttributes="Bold"    
                FontSize="32"
                Grid.Row="0"
                Grid.Column="0"   
                FontFamily="RAJDHANI-REGULAR.TTF"
                Margin="10,0"
                VerticalOptions="Fill" />

            <Image Source="bell_transparent.png" 
                Grid.Row="0" 
                Grid.Column="1" 
                WidthRequest="999"
                HeightRequest="35"

                   VerticalOptions="Center"></Image>


        </Grid>
        
        <Grid ColumnDefinitions="0.05*,1*,0.05*" RowDefinitions="2.5*,2*,2*,2*,2*,1.5*" Grid.Row="1" Grid.Column="0">

            <Border Stroke="#000000"
                BackgroundColor="Black"
                StrokeThickness ="3"
                Grid.Row="0" 
                Grid.Column="0"
                Grid.ColumnSpan="3">
                <Image Source="cart.jpg" 
                    Aspect="AspectFill"/>
            </Border>

            <CollectionView IsVisible="{Binding ThereAreBookings}" BackgroundColor = "#E1E0EB"
                Grid.Row="2"    
                    Grid.Column="1"
                    Grid.RowSpan="2"    
                                      
                    ItemsSource="{Binding ActiveBookings}"
                    SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ActiveBookings">
                        <Grid Padding="10">
                            <Border HeightRequest="100">
                                <Label Text="{Binding dealerReference}">
                                    
                                </Label>
                                
                            
                            </Border>    
                        </Grid>
                    </DataTemplate>
                    
                    
                </CollectionView.ItemTemplate>    
                
            </CollectionView>

            <Label Text="You have no scheduled appointments. Please make a booking below." IsVisible = "{Binding NoBookings}"
                TextColor="#696969"
                FontAttributes="Bold"    
                FontSize="24"
                Grid.Row="2"
                Grid.Column="1"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"
                FontFamily="RAJDHANI-REGULAR.TTF"
                  />


            <Grid ColumnDefinitions="0.25*,4*,1*,0.75*,0.5*" RowDefinitions="1*,1*" Grid.Row="1" Grid.Column="1" IsVisible = "{Binding ThereAreBookings}">

                <Label Text="Due Appointments for " 
                    TextColor="#000000"
                    FontAttributes="Bold"    
                    FontSize="24"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalOptions="End"                                         
                    FontFamily="RAJDHANI-REGULAR.TTF"
                      />

                <!--
                <Label  Text= "test"
                    Grid.Row="0"    
                    Grid.Column="2"
                    Grid.ColumnSpan="2"    
                    TextColor="#000000"
                    BackgroundColor="#FFFF00"   
                    MaxLines="1"
                    FontAttributes="Bold"    
                    FontSize="24"
                    FontFamily="RAJDHANI-REGULAR.TTF"
                    />
                -->

                <Grid BindableLayout.ItemsSource="{Binding ActiveBookings}" 
                      Grid.Row="0"    
                      Grid.Column="2">
                    
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="model:ActiveBookings">
                            <Label Text= "{Binding vehicleId}"
                            TextColor="#000000"
                            BackgroundColor="#FFFF00"   
                            MaxLines="1"
                            FontAttributes="Bold"    
                            FontSize="24"
                            FontFamily="RAJDHANI-REGULAR.TTF"       />


                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </Grid>   
                    <!--
                
                <CollectionView IsVisible="{Binding ThereAreBookings}" BackgroundColor = "#E1E0EB" 
                            ItemsSource="{Binding ActiveBookings}"
                            SelectionMode="Single"
                            VerticalScrollBarVisibility="Never"
                            HeightRequest="100">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:ActiveBookings">
                            <Grid>

                                <Label  Text= "{Binding vehicleId}"
                                            TextColor="#000000"
                                            BackgroundColor="#FFFF00"   
                                            MaxLines="1"
                                            FontAttributes="Bold"    
                                            FontSize="72"
                                            FontFamily="RAJDHANI-REGULAR.TTF"
                                            />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
                -->

            </Grid>
                
            <Grid ColumnDefinitions="*,2.6*,*" RowDefinitions="*,2.6*,*" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3">


                <BoxView 
                    Color="#211D4A" 
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor = "#E1E0EB"
                    CornerRadius= "8"
                    />

                <Label x:Name="label" Text="New Booking"

                    TextColor="#FFFFFF"
                    FontAttributes="Bold"    
                    FontSize="30"
                    Grid.Row="1"
                    Grid.Column="1"   
                    FontFamily="RAJDHANI-REGULAR.TTF"
                    VerticalOptions="Center"

                    HorizontalOptions="Center"   />


                <Button
                VerticalOptions="Center"
                HorizontalOptions="Center"
                />



            </Grid>



        </Grid>

        <Grid ColumnDefinitions="1*,1*,1*,1*" RowDefinitions="*" Grid.Row="2" Grid.Column="0" BackgroundColor="#FFFFFF">
           
            
        </Grid>


    
    </Grid>
</ContentPage>
