<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.MainPage"
             xmlns:model="clr-namespace:AutoLink.Model"
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             x:DataType="ViewModel:MainPageViewModel"
             Title=""  BackgroundColor="#FFFFFF">
    
    <Page.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="#211D4A"/>
    </Page.Behaviors>

    <Grid ColumnDefinitions="*" RowDefinitions="0.6*,11*,1*">

        <Grid ColumnDefinitions="*,40,10" RowDefinitions="*,0,0" Grid.Row="0" Grid.Column="0" >

            <BoxView 
                Color="#211D4A" 
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                BackgroundColor="#211D4A"
                Shadow="#000000 0 0.1"/>

            <Label Text="{Binding UserName, StringFormat='{}Hello, {0}!'}"
                TextColor="#FFFFFF"
                FontAttributes="Bold"    
                FontSize="32"
                Grid.Row="0"
                Grid.Column="0"   
                FontFamily="RAJDHANI-REGULAR.TTF"
                Margin="10,0"
                VerticalOptions="Fill" />

            <Image Source="bell_transparent.png" 
                Grid.Row="0" 
                Grid.Column="1" 
                WidthRequest="999"
                HeightRequest="35"

                   VerticalOptions="Center"></Image>


        </Grid>
        
        <Grid ColumnDefinitions="0.05*,1*,0.05*" RowDefinitions="2*,1*,2*,2*,2*,1.75*" Grid.Row="1" Grid.RowSpan ="2" Grid.Column="0">

            <Border Stroke="#000000"
                BackgroundColor="Black"
                StrokeThickness ="3"
                Grid.Row="0" 
                Grid.Column="0"
                Grid.ColumnSpan="3">
                <Image Source="cart.jpg" 
                    Aspect="AspectFill"/>
            </Border>


            <CollectionView  Grid.Row="2" Grid.Column="1"  Grid.RowSpan="3"
         ItemsSource="{Binding ActiveBookingDTOs}"
         SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ActiveBookingMainPageDTO">
                        <Border HeightRequest="90" Margin="0,0,0,24" 
                                Stroke ="#000000" StrokeThickness="1.5" 
                                StrokeShape="RoundRectangle 8,8,8,8"
                                BackgroundColor="#E1E0EB">

                            <Grid ColumnDefinitions="0.45*,*,0.25*" RowDefinitions="*">

                                <Grid ColumnDefinitions="0.1*,0.5*,0.1*,auto" RowDefinitions="0.3*,0.4*,1*,1*,1*,0.3*" Grid.Column="0">


                                    <Image Source="spanner.png" Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" />

                                    <Border Grid.Row="4" Grid.Column="1" Grid.RowSpan="1" StrokeShape="RoundRectangle 1,1,1,1">
                                        <Label  Text= "{Binding VehicleRegistration}" 
                                            TextColor="#000000"
                                                BackgroundColor="#FFFF00"
                                            MaxLines="1"
                                            FontAttributes="Bold"    
                                            FontSize="20"
                                            FontFamily="RAJDHANI-REGULAR.TTF"
                                            HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Start"
                                            />
                                    </Border>

                                    <BoxView WidthRequest="1" Color="BLACK" Grid.Row="1" Grid.Column="2" Grid.RowSpan="4"/>

                                    
                                </Grid>

                                

                                <Grid ColumnDefinitions="*,auto,*" RowDefinitions="0.15*,0.3*,0.1*,0.1*,0.3*" Grid.Column="1" >

                                    <Label  Text= "{Binding DealerName}" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                                        TextColor="#000000"
                                        MaxLines="1"
                                        FontAttributes="Bold"
                                        FontSize="32"
                                        FontFamily="RAJDHANI-REGULAR.TTF"
                                        />


                                    <Label 
                                        Text="{Binding BookingTypeString}" 
                                        Grid.Row="3" 
                                        Grid.Column="1" 
                                        Grid.RowSpan="2" 
                                        Grid.ColumnSpan="2"
                                        TextColor="#000000"
                                        MaxLines="1"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        FontFamily="RAJDHANI-REGULAR.TTF" 
                                        WidthRequest="200"/>



                                </Grid>

                                <Label  Text= ">" Grid.Column="2" 
                                        TextColor="#000000"
                                        MaxLines="1"
                                        FontAttributes="Bold"
                                        FontSize="72"
                                        FontFamily="RAJDHANI-REGULAR.TTF"
                                                />

                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        <Grid ColumnDefinitions="*" RowDefinitions="0.5*,*,*,*" Grid.Row="1" Grid.Column="1" IsVisible = "{Binding ThereAreBookings}">

            <Label Text="Due Appoitments" 
                TextColor="#000000"
                FontAttributes="Bold"    
                FontSize="40"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Grid.RowSpan="3"
                HorizontalTextAlignment="Center"
                FontFamily="RAJDHANI-REGULAR.TTF"
                    />



