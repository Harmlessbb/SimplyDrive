<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.MainPage"
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             x:DataType="ViewModel:MainPageViewModel"
             Title=""  BackgroundColor="#000000">
    <Page.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="#343152"/>
    </Page.Behaviors>
    <Grid ColumnDefinitions="*,auto" RowDefinitions="40,20">

        <BoxView 
            Color="#343152" 
            Grid.Row="0" 
            Grid.Column="0"
            BackgroundColor="#FFFFFF"/>

        <Label Text="Hello, Bob!"
            TextColor="#FFFFFF"
            FontSize="32"
            FontFamily="RAJDHANI-REGULAR.TTF"
            Padding="40,0"/>

        <Image Source="hamburger_bar.jpg" 
            Grid.Row="0" 
            Grid.Column="0" />


    </Grid>

</ContentPage>
