<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.MainPage"
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             x:DataType="ViewModel:MainPageViewModel"
             Title=""  BackgroundColor="#FFFFFF">
    
    <Page.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="#211D4A"/>
    </Page.Behaviors>

    <Grid ColumnDefinitions="*" RowDefinitions="0.6*,11*,1*">

        <Grid ColumnDefinitions="*,40,10" RowDefinitions="*,0,0" Grid.Row="0" Grid.Column="0">

            <BoxView 
                Color="#211D4A" 
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                BackgroundColor="#211D4A"
                Shadow="#000000 0 0.1"/>

            <Label Text="Hello, Bob!"
                TextColor="#FFFFFF"
                FontAttributes="Bold"    
                FontSize="32"
                Grid.Row="0"
                Grid.Column="0"   
                FontFamily="RAJDHANI-REGULAR.TTF"
                Margin="10,0"
                VerticalOptions="Fill" />

            <Image Source="bell_transparent.png" 
                Grid.Row="0" 
                Grid.Column="1" 
                WidthRequest="999"
                HeightRequest="35"

                   VerticalOptions="Center"></Image>


        </Grid>
        
        <Grid ColumnDefinitions="*" RowDefinitions="2.5*,2*,2*,2*,2*,1.5*" Grid.Row="1" Grid.Column="0">

            <Border Stroke="#000000"
                    BackgroundColor="Black"
                StrokeThickness="3">
                <Image Source="cart.jpg" 
                    Grid.Row="0" 
                    Grid.Column="0"
                    Aspect="AspectFill"/>
            </Border>

            <Grid ColumnDefinitions="0.25*,4*,1*,0.75*,0.5*" RowDefinitions="1*,1*" Grid.Row="1" Grid.Column="0">

                <Label Text="Due Appointments for "
                    TextColor="#000000"
                    FontAttributes="Bold"    
                    FontSize="28"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalOptions="End"                                         
                    FontFamily="RAJDHANI-REGULAR.TTF"
                      />

                <Border Grid.Row="0" Grid.Column="1">


                    <Label Text="AB24 CDE" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                            TextColor="#000000"
                            BackgroundColor="#FFFF00"   
                            MaxLines="1"
                            FontAttributes="Bold"    
                            FontSize="28"
                            FontFamily="RAJDHANI-REGULAR.TTF"
                          />

                </Border>

            </Grid>



            <BoxView 
                Color="#E1E0EB" 
                Grid.Row="2"
                Grid.Column="0"
                BackgroundColor = "#E1E0EB"
            />






            <Grid ColumnDefinitions="*,2.6*,*" RowDefinitions="*,2.6*,*" Grid.Row="5" Grid.Column="0">


                <BoxView 
                    Color="#211D4A" 
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor = "#E1E0EB"
                    CornerRadius= "8"
                    />

                <Label x:Name="label" Text="New Booking"

                    TextColor="#FFFFFF"
                    FontAttributes="Bold"    
                    FontSize="30"
                    Grid.Row="1"
                    Grid.Column="1"   
                    FontFamily="RAJDHANI-REGULAR.TTF"
                    VerticalOptions="Center"

                    HorizontalOptions="Center"   />


                <Button
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Command="{Binding attemptApiCallCommand}" />



            </Grid>



        </Grid>

        <Grid ColumnDefinitions="1*,1*,1*,1*" RowDefinitions="*" Grid.Row="2" Grid.Column="0" BackgroundColor="#FFFFFF">
            <Border 
                 Grid.Row="0"
                 Grid.Column="0"
                 Grid.ColumnSpan="4"
                 BackgroundColor="#FFFFFF"
                 Shadow="#000000 0 6"/>

            <Image Source="home_icon.png" 
                Grid.Row="0" 
                Grid.Column="0" 
                WidthRequest="999"
                HeightRequest="40"/>

        <Label Text="Home"

                TextColor="#000000"
                FontAttributes="Bold"    
                FontSize="13"
                Grid.Row="0"
                Grid.Column="0"   
                FontFamily="RAJDHANI-REGULAR.TTF"
                Margin="10,0"
                VerticalOptions="End"
                HorizontalOptions="Center"/>


            <Image Source="sedan_car.png" 
                 Grid.Row="0" 
                 Grid.Column="1" 
                 WidthRequest="999"
                 HeightRequest="60"/>


           <Label Text="Check-in"
                TextColor="#000000"
                FontAttributes="Bold"    
                FontSize="13"
                Grid.Row="0"
                Grid.Column="1"   
                FontFamily="RAJDHANI-REGULAR.TTF"
                Margin="10,0"
                VerticalOptions="End"

                HorizontalOptions="Center"/>




            <Image Source="person_icon.png" 
                 Grid.Row="0" 
                 Grid.Column="2" 
                 WidthRequest="999"
                 HeightRequest="40"/>




         <Label Text="Account"
                TextColor="#000000"
                FontAttributes="Bold"    
                FontSize="13"
                Grid.Row="0"
                Grid.Column="2"   
                FontFamily="RAJDHANI-REGULAR.TTF"
                Margin="10,0"
                VerticalOptions="End"
                HorizontalOptions="Center"/>




            <Image Source="settings_wheel.png" 
                 Grid.Row="0" 
                 Grid.Column="3" 
                 WidthRequest="999"
                 HeightRequest="40"/>



                <Label Text="Settings"
                TextColor="#000000"
                FontAttributes="Bold"    
                FontSize="13"
                Grid.Row="0"
                Grid.Column="3"   
                FontFamily="RAJDHANI-REGULAR.TTF"
                Margin="10,0"
                VerticalOptions="End"
                HorizontalOptions="Center"></Label>


        </Grid>



    </Grid>
</ContentPage>
