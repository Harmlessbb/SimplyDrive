<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.MainPage"
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             x:DataType="ViewModel:MainPageViewModel"
             Title=""  BackgroundColor="White">
    <Grid>
        <Grid RowDefinitions="830,*,*">

            <Grid Grid.Row="0" ColumnDefinitions="175,*,175" RowDefinitions="*,*,*" Padding="15">
                <Border Grid.Column="0" StrokeThickness="0" Stroke="Black" BackgroundColor="GhostWhite" >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid>
                        <Grid RowDefinitions="*,*">
                            <Border Stroke="Black" WidthRequest="150" HeightRequest="120" Grid.Row="0" BackgroundColor="WhiteSmoke">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5"/>
                                </Border.StrokeShape>
                                <Grid RowDefinitions="45,*">
                                    <Label Text="Next MOT Date"  HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" Padding="3"></Label>
                                    <Label Grid.Row="1" Text="PLACEHOLDER"  HorizontalTextAlignment="Center" FontSize="18" FontAttributes="None" Padding="3" TextColor="Grey"></Label>
                                </Grid>

                            </Border>
                            <Border Stroke="Black" WidthRequest="150" HeightRequest="120" Grid.Row="1" BackgroundColor="WhiteSmoke">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5"/>
                                </Border.StrokeShape>
                                <Grid RowDefinitions="70,*">
                                    <Label Text="Next Service Date"  HorizontalTextAlignment="Center" FontSize="18" FontAttributes="Bold" Padding="3"></Label>
                                    <Label Grid.Row="1" Text="PLACEHOLDER"  HorizontalTextAlignment="Center" FontSize="18" FontAttributes="None" Padding="3" TextColor="Grey"></Label>
                                </Grid>
                            </Border>

                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Column="2" RowDefinitions="*,70,50">
                    <Border Grid.Column="2" Stroke="Black" StrokeThickness="2" BackgroundColor="White" HeightRequest="150" VerticalOptions="Start">
                        <Border.Shadow>
                            <Shadow Brush="Black"
                            Offset="1,5"
                            Radius="5"
                            Opacity="0.5"></Shadow>
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5"/>
                        </Border.StrokeShape>
                        <Grid RowDefinitions="*,65">
                            <Image Source="renaultcliosideprof.png" Scale="0.9" Grid.Row="0" Grid.Column="1"></Image>
                            <Image Source="renaultlogo.png" Scale="0.7" Grid.Row="1" Grid.Column="0"></Image>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="1" Stroke="Black" StrokeThickness="2" BackgroundColor="GhostWhite" HeightRequest="50" WidthRequest="180" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black"
                            Offset="1,5"
                            Radius="2"
                            Opacity="0.25"></Shadow>
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Button Text="{Binding DisplayRegistration}" BackgroundColor="Yellow" TextColor="Black" FontAttributes="Bold" FontSize="25" TextTransform="Uppercase" Padding="5"></Button>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="2" Stroke="Black" StrokeThickness="2" BackgroundColor="GhostWhite" HeightRequest="60" WidthRequest="180" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black"
                            Offset="1,5"
                            Radius="2"
                            Opacity="0.25"></Shadow>
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="80"/>
                        </Border.StrokeShape>
                        <Button Text="Change Vehicle" BackgroundColor="Black" TextColor="White" FontAttributes="Bold" FontSize="20" Command="{Binding DisplayAllUserInfoCommand}"></Button>
                    </Border>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="300,*,*" >
                    <Border Grid.Column="1" Stroke="Grey" StrokeThickness="1.15" BackgroundColor="GhostWhite" HeightRequest="150" VerticalOptions="Start" Grid.Row="1" WidthRequest="350">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black"
                            Offset="1,5"
                            Radius="2"
                            Opacity="0.25"></Shadow>
                        </Border.Shadow>
                        <Grid RowDefinitions="55,*">
                            <Label Text="User Details" HorizontalOptions="Center" FontSize="24" FontAttributes="Bold"></Label>
                            <Label Grid.Row="1" Text="{Binding DisplayName}" HorizontalTextAlignment="Center" HorizontalOptions="Center" FontSize="24" FontAttributes="None" TextColor="Grey"></Label>
                        </Grid>

                    </Border>

                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="200,*,*" >
                    <Border Grid.Column="1" Stroke="Grey" StrokeThickness="1.15" BackgroundColor="GhostWhite" HeightRequest="150" VerticalOptions="Start" Grid.Row="1" WidthRequest="350">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2"/>
                        </Border.StrokeShape>
                        
                        <Border.Shadow>
                            <Shadow Brush="Black"
                            Offset="1,5"
                            Radius="2"
                            Opacity="0.25"></Shadow>
                        </Border.Shadow>
                    </Border>

                </Grid>

            </Grid>


        </Grid>
</Grid>
</ContentPage>
