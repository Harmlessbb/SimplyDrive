<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoLink.View.SignUpPage"
             Title="SignUpPage"             
             xmlns:ViewModel ="clr-namespace:AutoLink.ViewModel"
             x:DataType="ViewModel:SignUpViewModel"
>

    <Grid ColumnDefinitions="*,auto,*" RowDefinitions="250,20,200,*">
        <Border Grid.Column="1" Grid.Row="1" HeightRequest="140">
            <Grid ColumnDefinitions="*,350,*" RowDefinitions="auto,auto,auto,auto" Grid.Column="1" Grid.Row="1">

                <Entry Placeholder="Email Address" Grid.Column="1" Grid.Row="1" HeightRequest="10" ReturnType="Next" Text="{Binding userInputUsername}" IsEnabled="{Binding SignUpPhase1}" IsVisible="{Binding SignUpPhase1}"></Entry>
                <Entry Placeholder="Password" Grid.Column="1" Grid.Row="2" HeightRequest="10" Text="{Binding userInputPassword}" IsEnabled="{Binding SignUpPhase1}" IsVisible="{Binding SignUpPhase1}"></Entry>
                <Entry Placeholder="Confirm Password" Grid.Column="1" Grid.Row="3" HeightRequest="10" Text="{Binding userInputPasswordConfirm}" IsEnabled="{Binding SignUpPhase1}" IsVisible="{Binding SignUpPhase1}"></Entry>

                <Entry Placeholder="First Name" Grid.Column="1" Grid.Row="1" HeightRequest="10" ReturnType="Next" Text="{Binding userInputFirstName}" IsEnabled="{Binding SignUpPhase2}" IsVisible="{Binding SignUpPhase2}"></Entry>
                <Entry Placeholder="Last Name" Grid.Column="1" Grid.Row="2" HeightRequest="10" ReturnType="Next" Text="{Binding userInputLastName}" IsEnabled="{Binding SignUpPhase2}" IsVisible="{Binding SignUpPhase2}"></Entry>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="*,5,*" HeightRequest="50">
            <Button Grid.Column="2" Grid.Row="1" Text="Continue" Command="{Binding AttemptSignUpPhase1Command}" IsEnabled="{Binding SignUpPhase1}" IsVisible="{Binding SignUpPhase1}"></Button>
            <Button Grid.Column="2" Grid.Row="1" Text="Create Account" Command="{Binding AttemptSignUpPhase2Command}" IsEnabled="{Binding SignUpPhase2}" IsVisible="{Binding SignUpPhase2}"></Button>
            <Button Grid.Column="0" Grid.Row="1" Text="Back To Login" Command="{Binding ReturnToMenuCommand}"></Button>
        </Grid>


    </Grid>
</ContentPage>
    