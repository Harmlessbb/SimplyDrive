<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimplyDrive.View.DevPage1"
             Title="DevPage1"             
             xmlns:ViewModel ="clr-namespace:SimplyDrive.ViewModel"
             x:DataType="ViewModel:DevPage1ViewModel">

    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*">

        <Button Text="WhoAmI?" 
                Command="{Binding LoadUserInfoCommand}" 
                Grid.Row="0" Grid.Column="0" />

        <Button Text="See Owned Vehicles" 
                Command="{Binding RetrieveOwnedVehiclesCommand}" 
                Grid.Row="1" Grid.Column="0" />

        <Button Text="Add Vehicle" 
                Command="{Binding AddVehicleCommand}" 
                Grid.Row="1" Grid.Column="1" />
        
        <Button Text="Remove Vehicle" 
                Command="{Binding RemoveVehicleCommand}" 
                Grid.Row="1" Grid.Column="2" />
        


    </Grid>

</ContentPage>