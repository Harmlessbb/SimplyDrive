<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoLink.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AutoLink"
    xmlns:View="clr-namespace:AutoLink.View"
    Title="AutoLink"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="Black">

 
    <ShellContent
        Title="SignUpPage"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" 
        />
    <TabBar>

        <ShellContent
            
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage"
            Icon="home.png"/>




        <ShellContent
            Title="Check-in"
            ContentTemplate="{DataTemplate View:NewBookingsPage}"
            Route="NewBookingsPage"
            Icon="sedan_car.png">

        </ShellContent>

        <ShellContent
            Title="Account"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="NewBookingsPage"
            Icon="person_icon.png">

        </ShellContent>

    </TabBar>
    


</Shell>
