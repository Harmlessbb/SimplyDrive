<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoLink.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AutoLink"
    xmlns:views="clr-namespace:AutoLink.View"
    Title="AutoLink"
    Shell.FlyoutBehavior="Disabled">
    


    <ShellContent
        Title="SignUpPage"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" 
        />


    <TabBar>

        <ShellContent
            
        Title="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"        
    />

        <!--  <ShellContent
            Title="NewBookingsPage"
            ContentTemplate="{DataTemplate views:NewBookingsPage}"
            Route="NewBookingsPage">
            
        </ShellContent> -->

    </TabBar>
    


</Shell>
